{
  "name": "ag-coop-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "share": "tsx tools/tunnel/share.ts",
    "typecheck": "tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint:engine": "tsx tools/lint/engineRules.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim/run.ts",
    "data:review": "tsx tools/data-review/generate.ts",
    "perf": "tsx tools/perf/run.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
