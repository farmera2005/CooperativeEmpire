# Copy to .env (never commit .env). Used by docker compose and by `npm run share`.

# Ports with Docker: the app service (accounts and the admin menu) and the optional plain nginx site
# (web, `--profile static`).
APP_PORT=8080
HOST_PORT=8081

# Cloudflare named tunnel (optional). Without a token, `npm run share` and the "tunnel" compose
# profile open a quick tunnel on a random *.trycloudflare.com address instead.
CLOUDFLARE_TUNNEL_TOKEN=
# The public hostname routed to the tunnel, e.g. coop.example.com (lets `npm run dev`/`preview`
# answer requests for it, and is printed when sharing).
TUNNEL_HOSTNAME=

# Temporary password for the built-in "admin" account, used only when the accounts are first
# created (a new data folder or volume). Leave empty to use the one given at setup. It must be
# changed at first sign-in either way. Lost it later? `npm run admin:reset`.
COOP_ADMIN_PASSWORD=
