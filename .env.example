# Copy to .env (never commit .env). Used by docker compose and by `npm run share`.

# Local port for the game when run with Docker.
HOST_PORT=8080

# Cloudflare named tunnel (optional). Without a token, `npm run share` and the "tunnel" compose
# profile open a quick tunnel on a random *.trycloudflare.com address instead.
CLOUDFLARE_TUNNEL_TOKEN=
# The public hostname routed to the tunnel, e.g. coop.example.com (lets `npm run dev`/`preview`
# answer requests for it, and is printed when sharing).
TUNNEL_HOSTNAME=
